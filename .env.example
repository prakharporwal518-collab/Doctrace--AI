# ─── Browser (Vite) ─────────────────────────────────────────────────────────
# Leave both empty to run in offline demo mode (data stays in the browser).
# Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Netlify Functions (server only, never exposed to the browser) ─────────
# One of these enables LLM extraction and chat. Without them the rules engine is used.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini        # pick one when both keys are set

# Functions verify the user's Supabase session before spending your LLM quota.
# They read VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY automatically; set these only to override.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# REQUIRE_AUTH=true          # also require sign-in in offline mode deployments

# ─── Seed script only (npm run seed). Do NOT add this to Netlify. ───────────
SUPABASE_SERVICE_ROLE_KEY=
